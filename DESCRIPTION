Type: Package
Package: locuscomparer
Title: locuscomparer: Visualization of GWAS-QTL Colocalization Events
Version: 1.0.0
Authors@R: c(
    person("Boxiang", "Liu", , "jollier.liu@gmail.com", role = c("aut", "cre")),
    person("Michael", "Gloudemans", , "mgloud@stanford.edu", role = "ctb"),
    person("Stephen", "Montgomery", , "smontgom@stanford.edu", role = "ctb")
